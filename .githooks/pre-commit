#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 1
root="$(git rev-parse --show-toplevel)"

# 1) 凭据与敏感信息
"$root/scripts/secrets_scan.sh" || exit 1
# 2) 文档结构与坑编号
"$root/scripts/md_check.sh" || exit 1
# 3) 链接与双向结构
"$root/scripts/link_check.sh" || exit 1
# 4) 上下文预算（阈值取自 budget.conf）
"$root/scripts/context_budget.sh" || exit 1

# ---- 以下为 2026-11-18 复盘后新增的机器校验（M1/M3/M4），全部阻断式 ----
# [M3] 阈值单一来源
"$root/scripts/threshold_check.sh" || exit 1
# [M1] 裸路径存在性
"$root/scripts/paths_check.sh" || exit 1
# [M4-a] 认领表格式
"$root/scripts/claims_audit.sh" || exit 1
# [M4-b] 坑账本必填字段
"$root/scripts/pitfall_check.sh" || exit 1

# [D-7] 涉税/政策依据核验（依 ADR-010 以告警模式上线，按 P-015 零误报后转阻断）
"$root/scripts/policy_guard.sh" || exit 1

# 交付反馈清单机械代理：每次提交即生成 D-1/D-2/D-3/D-5 草稿（非阻断）
"$root/scripts/delivery_report.sh" >&2
